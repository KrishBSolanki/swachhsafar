rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in Firebase user can read the users, trains, journeys,
    // and staff_allot collections (needed for login profile lookup and
    // assignment sync). No client-side writes allowed.
    match /users/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /trains/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /journeys/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /staff_allot/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Swachh Safar PWA self-registration profiles.
    // Document ID is the device-generated user UUID. A signed-in user may only
    // create/update their own profile; password material is never accepted.
    match /app_users/{userId} {
      function isOwner() {
        return request.auth != null && resource.data.auth_uid == request.auth.uid;
      }

      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uuid', 'auth_uid', 'username', 'email', 'registered_at', 'account_status', 'source', 'synced_at'])
          && d.keys().hasAll(['uuid', 'auth_uid', 'username', 'email', 'registered_at', 'account_status'])
          && d.uuid == userId
          && d.auth_uid == request.auth.uid
          && d.email == request.auth.token.email
          && d.account_status == 'active';
      }

      allow read: if isOwner();
      allow create: if request.auth != null && validProfile();
      allow update: if isOwner() && validProfile()
        && request.resource.data.registered_at == resource.data.registered_at;
      allow delete: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
