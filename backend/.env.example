# Copy to backend/.env and fill in. Never commit real values.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://swachh:CHANGE_ME@127.0.0.1:5432/swachh_safar

# Firebase Admin: path to a service-account JSON kept outside the repo,
# or leave empty to use Application Default Credentials.
FIREBASE_PROJECT_ID=swachh-safar
FIREBASE_CREDENTIALS_FILE=
FIREBASE_STORAGE_BUCKET=swachh-safar.appspot.com

# firebase | local  (local is for development only)
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=./var/media

# Long random secret used to HMAC OTP codes (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
OTP_PEPPER=CHANGE_ME

CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# disabled | http
SMS_PROVIDER=disabled
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# disabled | rapidapi
PNR_PROVIDER=disabled
PNR_API_URL=https://irctc-indian-railway-pnr-status.p.rapidapi.com/getPNRStatus/
PNR_API_HOST=irctc-indian-railway-pnr-status.p.rapidapi.com
PNR_API_KEY=
